# The test groups that are off by default: one KEY=VALUE per line, no logic. Read by the CI jobs that run tests (a
# step appends this file to $GITHUB_ENV, comments stripped) and by `devvm/lane-env.sh` (it sources the file).
# A lane or a step that runs a group sets the variable itself, and its value wins; a group that asks for consent
# (`<env>_CONSENT=1`) gets it there too.
#
# A group that gains or loses real privileges, or may signal an unrelated process, is off: principles 9 and 10
# (`docs/principles.md`).
# Root, and real uid switching (needs a root that can `setuid`).
COSCA_TEST_ROOT=0
COSCA_TEST_UID_SWITCH=0
COSCA_TEST_NAMESPACES=0
COSCA_TEST_TRACER=0
# Runs only where a step provisions a setuid-root helper.
COSCA_TEST_SETUID=0
# Needs a delegated cgroup.
COSCA_TEST_CGROUP=0
# Gains real administrator or root privileges.
COSCA_TEST_ELEVATION=0
# Windows groups: the drive-mapping test and the canaries run in steps of the test job; the executing probes run
# only in windows-probes.yaml.
COSCA_TEST_DRIVE_MAPPING=0
COSCA_TEST_PATH_PROBES=0
COSCA_TEST_SHELL_EXECUTE=0
COSCA_TEST_SHELL_PROBES=0
COSCA_TEST_ELEVATION_ROUTES=0
# May signal an unrelated process.
COSCA_TEST_STRAY_SIGNAL=0
