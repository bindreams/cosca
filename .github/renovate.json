{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "automerge": true,
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Cargo.toml keeps library version ranges; the lockfile is the pin, so updates within range touch only Cargo.lock",
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Group non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Group non-major Cargo updates",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "cargo"
    },
    {
      "description": "Group non-major prek hook updates",
      "matchFileNames": [
        "prek.toml"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "prek"
    },
    {
      "description": "Never group major updates: one PR per major",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "prek hook revs in prek.toml, pinned by commit SHA with a `# frozen: <tag>` comment",
      "managerFilePatterns": [
        "/(^|/)prek\\.toml$/"
      ],
      "matchStrings": [
        "repo = \"https://github\\.com/(?<depName>[^\"/]+/[^\"/]+)\"\\s*\\n(?:\\s*#[^\\n]*\\n)*\\s*rev = \"(?<currentDigest>[0-9a-f]{40})\"\\s*# frozen: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}
