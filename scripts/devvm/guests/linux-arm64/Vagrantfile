# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# devvm guest: linux-arm64 — for cgroup v2 lanes, natively virtualized (HVF) on an Apple
# Silicon host, cross-arch-emulated (TCG) on an x86-64 host.
#
# Not meant to be run directly with `vagrant up` in this directory — use
# `scripts/devvm.py up linux-arm64`, which sets VAGRANT_DOTFILE_PATH and DEVVM_REPO_ROOT so
# all state lands under .tmp/devvm/ in the worktree, never in the box's own directory.
#
# Box: perk/ubuntu-2204-arm64, provider qemu, version pinned below — the aarch64 cloud-init
# box the vagrant-qemu plugin's own README cites as a known-working example. Ubuntu 22.04's
# systemd (249) defaults to the unified cgroup v2 hierarchy.

require_relative "../_shared/fix_macos_port_check"

REPO_ROOT = ENV.fetch("DEVVM_REPO_ROOT")

Vagrant.configure("2") do |config|
  config.vm.box = "perk/ubuntu-2204-arm64"
  config.vm.box_version = "20250702"
  # Pin explicitly rather than rely on Vagrant's host-architecture auto-detection matching by
  # accident — see the box_architecture comment in the windows-x64/linux-x64 Vagrantfiles.
  config.vm.box_architecture = "arm64"
  config.vm.hostname = "cosca-devvm-linux-arm64"

  config.vm.provider "qemu" do |qe|
    qe.arch = "aarch64"
    qe.memory = "4096"
    qe.smp = "2"
    # This host may already have unrelated VMs (this tool's or not) holding the default
    # forwarded port; let Vagrant pick a free one instead of failing `up`.
    qe.ssh_auto_correct = true
  end

  # A one-shot rsync push, not a live mount: the guest cannot write back into the host's
  # source tree. Files land read-only (F444); directories stay writable (D755) so later
  # `devvm.py sync` runs can still add/remove/replace files.
  config.vm.synced_folder REPO_ROOT, "/home/vagrant/cosca",
    type: "rsync",
    rsync__exclude: [".git/", "target/", ".tmp/"],
    rsync__args: ["--archive", "--delete", "--chmod=D755,F444"]

  config.vm.provision "shell", path: "../../provision/linux-rust.sh", privileged: false
end
